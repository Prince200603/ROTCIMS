# =============================================================================
# ROTCIMS Environment Variables
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or any file with real secrets to version control.
#
# For Vercel Deployment:
#   Add each variable in: Vercel Dashboard → Your Project → Settings → Environment Variables
# =============================================================================

# ── GOOGLE CLOUD SERVICE ACCOUNT (Google Drive API) ──────────────────────────
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Select or create your ROTCIMS project.
# 3. Enable the "Google Drive API":
#    APIs & Services → Library → Search "Google Drive API" → Click "Enable"
# 4. Create a Service Account:
#    IAM & Admin → Service Accounts → "Create Service Account" (e.g. rotcims-storage)
#    Role: Project Viewer or Editor (or Service Account User)
# 5. Generate and download JSON key:
#    Click your Service Account → "Keys" tab → "Add Key" → "Create new key" → JSON
# 6. Copy the "client_email" and "private_key" values into these variables below:
GOOGLE_SERVICE_ACCOUNT_EMAIL=rotcims-storage@your-project-id.iam.gserviceaccount.com

# The RSA private key from the JSON key file.
# Keep newlines formatted as \n or paste literal multiline between quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...your...key...here...\n-----END RSA PRIVATE KEY-----\n"

# ── GOOGLE DRIVE ROOT FOLDER ID ──────────────────────────────────────────────
# 1. In Google Drive, create a new folder named "ROTCIMS" (or use an existing one).
# 2. IMPORTANT PERMISSION STEP:
#    Right-click the "ROTCIMS" folder → Click "Share"
#    Paste your Service Account Email (GOOGLE_SERVICE_ACCOUNT_EMAIL above)
#    Set permission to "Editor" → Click "Send" / "Save".
#    (Without this step, the Service Account will not be able to write to your Drive!)
# 3. Copy the Folder ID from the URL:
#    URL: https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz
#    The ID is: 1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_DRIVE_FOLDER_ID=your_rotcims_root_folder_id_here

# ── SUBFOLDER DIRECTORY STRUCTURE (Auto-created automatically if missing) ─────
# The system automatically structures your Drive into:
#   ├── ROTCIMS
#   │   ├── POSTS
#   │   │   ├── Images
#   │   │   └── Videos
#   │   ├── LEARNING_MODULES
#   │   │   ├── PDF
#   │   │   ├── WORD
#   │   │   ├── EXCEL
#   │   │   ├── POWERPOINT
#   │   │   └── VIDEOS
#   │   ├── CADET_PHOTOS
#   │   ├── CADET_DOCUMENTS
#   │   └── CERTIFICATES

# ── SUPABASE CREDENTIALS ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://cntisxkugmvwsommzjom.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=sb_publishable_crUK3jaModJMUqnZjnma_w_-9i-CEns
